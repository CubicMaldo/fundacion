<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS en producción (Hostinger SSL)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Seguridad: Bloquear acceso a archivos ocultos (excepto .well-known)
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # Seguridad: Bloquear acceso a logs de solicitudes
  RewriteRule ^api/logs - [F,L]

  # Dynamic OpenGraph para Bots y Crawlers (WhatsApp, Facebook, Twitter, Telegram, Discord, LinkedIn)
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Discordbot|Slackbot) [NC]
  RewriteCond %{REQUEST_URI} ^/(programas|blog|estudia|inscripcion|contacto|quienes-somos|portal-estudiantil) [NC]
  RewriteRule ^(.*)$ /og.php [L]

  # Servir archivos y carpetas reales directamente (CSS, JS, imágenes, api/notificar.php, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redireccionar todas las demás rutas a index.html (SPA TanStack Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Seguridad adicional: Cabeceras HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Evitar que index.html quede cacheado en versiones viejas
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>

# Compresión GZIP / Deflate para LiteSpeed y Apache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caché óptimo de archivos estáticos inmutables en Hostinger
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
