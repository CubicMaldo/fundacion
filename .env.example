# ==============================================================================
# FUNASF Colombia — Variables de Entorno de Producción
# ==============================================================================
# Nota para Hostinger: En hosting compartido (LiteSpeed/Apache), estas variables 
# deben estar presentes en el momento de compilar (npm run build) para que Vite 
# las incruste en los scripts JavaScript de la carpeta dist/.
# ==============================================================================

# URL de la instancia de Supabase (Backend de BD, Auth y Storage)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-anon-publica-de-supabase
